+function budded(g: THREE.BufferGeometry): THREE.BufferGeometry {
+  const list = (geometry(MODEL, 'blossom').userData.extras as { balls?: number[][] } | undefined)?.balls ?? []
+  const pos = g.getAttribute('position')
+  const bud = new Float32Array(pos.count * 4)
+  let low = Infinity
+  let far = 1e-3
+  let cx = 0
+  let cz = 0
+  for (const b of list) {
+    low = Math.min(low, b[1]! + offset[1])
+    cx += (b[0]! + offset[0]) / list.length
+    cz += (b[2]! + offset[2]) / list.length
+  }
+  for (const b of list) far = Math.max(far, Math.hypot(b[0]! + offset[0] - cx, b[1]! + offset[1] - low, b[2]! + offset[2] - cz))
+  for (let i = 0; i < pos.count; i++) {
+    const x = pos.getX(i)
+    const y = pos.getY(i)
+    const z = pos.getZ(i)
+    let best = Infinity
+    let at: [number, number, number] = [x, y, z]
+    for (const b of list) {
+      const c: [number, number, number] = [b[0]! + offset[0], b[1]! + offset[1], b[2]! + offset[2]]
+      const d = Math.hypot(x - c[0], y - c[1], z - c[2]) - b[3]!
+      if (d < best) {
+        best = d
+        at = c
+      }
+    }
+    bud.set([at[0], at[1], at[2], list.length ? Math.hypot(at[0] - cx, at[1] - low, at[2] - cz) / far : 0], i * 4)
+  }
+  g.setAttribute('aBud', new THREE.BufferAttribute(bud, 4))
+  return g
+}
