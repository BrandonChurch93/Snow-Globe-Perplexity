{
  "name": "snow-globe-seasons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A glass snow globe that changes season when it is shaken",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clock": "node tools/clock.mjs",
    "look": "node tools/look.mjs",
    "progress": "node tools/progress.mjs",
    "caps": "node tools/caps.mjs",
    "build": "node tools/assetindex.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "parts": "node tools/parts.mjs",
    "dev": "vite",
    "still": "node tools/still.mjs",
    "review": "node tools/review.mjs",
    "status": "node tools/status.mjs",
    "determinism": "node tools/determinism.mjs",
    "strict": "node tools/strict.mjs",
    "gate": "node tools/gate.mjs",
    "budget": "node tools/budget.mjs",
    "keep": "node tools/keep.mjs",
    "crops": "node tools/crops.mjs",
    "compare": "node tools/compare.mjs",
    "animatic": "node tools/animatic.mjs",
    "simcache": "node tools/simcache.mjs",
    "measure": "node tools/measure.mjs",
    "sheet": "node tools/sheet.mjs",
    "seq": "node tools/seq.mjs",
    "sound": "node tools/sound.mjs",
    "soundcheck": "node tools/soundcheck.mjs",
    "audiomap": "node tools/audiomap.mjs",
    "cut": "node tools/cut.mjs",
    "mix": "node tools/mix.mjs",
    "film": "node tools/film.mjs",
    "opening": "node tools/opening.mjs",
    "loop": "node tools/loop.mjs",
    "stress": "node tools/stress.mjs",
    "pack": "node tools/pack.mjs",
    "hostcheck": "node tools/hostcheck.mjs",
    "render:local": "node tools/render-local.mjs",
    "make": "node tools/make.mjs",
    "texpack": "node tools/texpack.mjs",
    "firstlook": "node tools/firstlook.mjs",
    "fit": "node tools/fit.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.59.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
